# ===========================================================================
# 构建期产物：只在 CI / 本地执行构建时出现，不属于仓库内容
# ===========================================================================

# 构建期注入的辅助文件（wan-settings 等，随固件发布到 /etc/immortalwrt-builder/）
/files/etc/immortalwrt-builder/

# 设备端 apk 源列表与 dllkids 公钥（build.sh 生成）
/files/etc/apk/

# OpenClash 构建期下载的内核与 GeoIP/GeoSite（build.sh 生成，
# 含 ~10 MB 的 clash_meta 二进制）
/files/etc/openclash/

# 工作流运行期创建的注入目录（存放 custom_router_ip.txt）
/custom/

# 构建输出
/bin/

# Python 字节码缓存（本地跑 shell/*.py 产生，如 shell/audit.py、shell/unpack_fw.py）
__pycache__/
*.pyc
